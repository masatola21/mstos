{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/marketing-automation",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/billing-automation",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/fonts/**"
    }
  }
}
