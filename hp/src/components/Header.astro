---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'ホーム', href: '/' },
  { name: 'サービス一覧', href: '/services' },
  { name: 'お役立ちメディア', href: '/media' },
  { name: '商品・ツール', href: '/products' },
  { name: '資料請求', href: '/materials' },
  { name: '会社概要', href: '/company' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-sand-200 transition-all duration-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- 正式ロゴ画像（トリミング済み横長ロゴでスマホでも大きく表示） -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img
          src="/images/logo.png"
          alt="有限会社MST"
          class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105"
          style="height: 38px; width: auto; max-width: 170px; object-fit: contain;"
          width="170"
          height="38"
        />
      </a>

      <!-- デスクトップ ナビゲーション -->
      <nav class="hidden lg:flex items-center gap-6">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm font-semibold transition-colors py-1 ${
                isActive 
                  ? 'text-brand-700 border-b-2 border-brand-600 font-bold' 
                  : 'text-gray-600 hover:text-brand-900'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- デスクトップ CTAボタン群（3分診断を最優先配置） -->
      <div class="hidden sm:flex items-center gap-2.5">
        <a
          href="/diagnosis"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-amber-950 bg-amber-400 hover:bg-amber-300 rounded-lg shadow-sm transition-all duration-200 hover:shadow-md hover:scale-[1.02]"
        >
          <span>📊</span>
          <span>3分無料診断</span>
        </a>

        <a
          href="https://lin.ee/qWsuD6f" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-[#06C755] bg-[#06C755]/10 border border-[#06C755]/20 rounded-lg hover:bg-[#06C755] hover:text-white transition-all duration-200"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19.365 9.863c.349.001.62.288.621.637v.018c-.001.35-.272.637-.621.637h-3.414v2.778h3.414c.349 0 .62.287.621.637 0 .349-.272.637-.621.637h-4.051a.636.636 0 01-.637-.637V7.094c0-.349.288-.636.637-.636h4.051c.349 0 .62.287.621.636 0 .35-.272.637-.621.637h-3.414v2.132h3.414zm-5.748-2.769a.638.638 0 01.637.636v7.351a.638.638 0 01-.637.637.637.637 0 01-.637-.637V7.73a.637.637 0 01.637-.636zm-3.136 0a.638.638 0 01.637.636v4.636l3.526-4.996a.638.638 0 01.895-.145.637.637 0 01.144.896l-4.148 5.875a.637.637 0 01-.522.271.637.637 0 01-.532-.284V7.73a.637.637 0 01.637-.636h-.637zm-6.19 0a.637.637 0 01.637.636v5.876h3.414c.349 0 .62.287.621.637 0 .349-.272.636-.621.636H4.291a.638.638 0 01-.637-.636V7.73a.637.637 0 01.637-.636h.637zM12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
          </svg>
          LINE相談
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center px-3.5 py-2 text-xs font-bold text-white bg-brand-900 rounded-lg hover:bg-brand-800 transition-colors shadow-sm"
        >
          お問い合わせ
        </a>
      </div>

      <!-- モバイル ヘッダー右端（診断ボタン ＋ ハンバーガー） -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href="/diagnosis"
          class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold text-amber-950 bg-amber-400 rounded-lg shadow-sm"
        >
          <span>📊</span>
          <span>無料診断</span>
        </a>

        <!-- モバイル ハンバーガーメニューボタン -->
        <button
          id="mobile-menu-open"
          type="button"
          class="p-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-sand-100 transition"
          aria-label="メニューを開く"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- モバイル右端スライドイン ドロワーメニュー -->
<div id="drawer-container" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 lg:hidden">
  
  <!-- 半透明背景オーバーレイ（タップで閉じる） -->
  <div id="drawer-backdrop" class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity"></div>

  <!-- 右端スライドパネル本体 -->
  <div
    id="drawer-panel"
    class="absolute top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out pointer-events-auto overflow-y-auto"
  >
    <!-- パネルヘッダー -->
    <div>
      <div class="p-6 border-b border-sand-200 flex items-center justify-between">
        <img
          src="/images/logo.png"
          alt="有限会社MST"
          class="h-8 w-auto object-contain"
          style="height: 32px; width: auto;"
        />
        <button
          id="mobile-menu-close"
          type="button"
          class="p-2 rounded-lg text-gray-500 hover:text-slate-900 hover:bg-sand-100 transition"
          aria-label="メニューを閉じる"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- 診断ハイライトバナー（ドロワー内最上部） -->
      <div class="p-4 pb-2">
        <a
          href="/diagnosis"
          class="block p-4 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-300 to-amber-500 text-slate-950 shadow-md hover:shadow-lg transition group border border-amber-300"
        >
          <div class="flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-amber-900">
            <span class="w-2 h-2 rounded-full bg-rose-600 animate-ping"></span>
            わずか5問・登録不要で即判定
          </div>
          <div class="text-sm font-black mt-1 flex items-center justify-between">
            <span>📊 3分経営ボトルネック診断</span>
            <span class="text-xs group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-[11px] text-slate-800 mt-1 leading-snug font-medium">
            自社が今一番手を打つべき急所がその場でわかります
          </p>
        </a>
      </div>

      <!-- ナビゲーションリンク一覧 -->
      <nav class="p-4 pt-1 space-y-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`flex items-center justify-between px-4 py-3 rounded-xl text-sm font-semibold transition ${
                isActive
                  ? 'bg-brand-50 text-brand-700 font-bold'
                  : 'text-slate-800 hover:bg-sand-100 hover:text-brand-900'
              }`}
            >
              <span>{link.name}</span>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- パネル下部CTAボタン群 -->
    <div class="p-6 border-t border-sand-200 space-y-3 bg-sand-50/50">
      <a
        href="https://lin.ee/qWsuD6f"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3.5 px-4 bg-[#06C755] text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 shadow"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
        </svg>
        <span>LINEで無料相談する</span>
      </a>

      <a
        href="/contact"
        class="w-full py-3 px-4 bg-brand-900 hover:bg-brand-800 text-white font-bold text-xs rounded-xl text-center block transition shadow-sm"
      >
        お問い合わせ・ご相談窓口
      </a>
    </div>

  </div>
</div>

<script>
  function setupDrawer() {
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    const container = document.getElementById('drawer-container');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');

    if (!openBtn || !closeBtn || !container || !backdrop || !panel) return;

    const openDrawer = () => {
      container.classList.remove('pointer-events-none', 'opacity-0');
      container.classList.add('pointer-events-auto', 'opacity-100');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    };

    const closeDrawer = () => {
      container.classList.remove('pointer-events-auto', 'opacity-100');
      container.classList.add('pointer-events-none', 'opacity-0');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Escapeキーで閉じる
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
  }

  // 初回マウント時 ＆ ページ遷移時の初期化
  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
