---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="お問い合わせ・ご相談窓口 | 有限会社MST"
  description="有限会社MSTへのお問い合わせ・ご相談フォーム。経営戦略・利益改善顧問、業務自動化、AI経営OS、介護保険外サービス開業支援など、お気軽にお問い合わせください。"
>
  <!-- ページヘッダー -->
  <section class="bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white py-14 sm:py-20 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-300 tracking-widest uppercase bg-brand-800 px-3.5 py-1.5 rounded-full border border-brand-700">
        CONTACT US
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold font-serif text-white">
        お問い合わせ・ご相談
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        経営課題の整理、業務の属人化解消、システム自動化、新規事業の立ち上げなど、<br class="hidden sm:inline" />
        どのような段階のご相談でも丁寧に対応いたします。
      </p>
    </div>
  </section>

  <!-- お問い合わせセクション -->
  <section class="py-12 sm:py-20 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- お電話・LINE案内カード -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-6">
            <div>
              <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
                お急ぎの方へ
              </span>
              <h3 class="text-xl font-bold font-serif text-slate-900 mt-3">
                公式LINEやメールでもご相談いただけます
              </h3>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed">
                「フォームに入力する時間がない」「チャット感覚でまずは質問したい」という方は、公式LINEをご活用ください。
              </p>
            </div>

            <!-- LINEバナー -->
            <a
              href="https://lin.ee/4Vl9v91"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl bg-[#06C755] text-white hover:opacity-95 transition shadow"
            >
              <div class="flex items-center gap-3">
                <svg class="w-8 h-8 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
                </svg>
                <div>
                  <div class="text-xs font-semibold opacity-90">MST 公式LINEアカウント</div>
                  <div class="text-sm font-bold">LINEで無料相談する →</div>
                </div>
              </div>
            </a>

            <!-- メール・FAX案内 -->
            <div class="border-t border-sand-200 pt-4 space-y-2">
              <div>
                <span class="text-xs text-gray-500 font-bold block">メールでのお問い合わせ</span>
                <a href="mailto:contact@mstcorp.info" class="text-base font-bold text-brand-700 underline hover:text-brand-900">
                  contact@mstcorp.info
                </a>
              </div>
              <div>
                <span class="text-xs text-gray-500 font-bold block">FAXでのお問い合わせ</span>
                <div class="text-base font-bold text-slate-900">
                  0584-91-4897
                </div>
              </div>
            </div>
          </div>

          <!-- ご相談の流れ -->
          <div class="bg-brand-950 text-white p-6 sm:p-8 rounded-2xl shadow-sm space-y-4">
            <h4 class="text-base font-bold font-serif text-brand-300">
              初回ご相談の流れ
            </h4>
            <ol class="space-y-3 text-xs text-slate-300">
              <li class="flex items-start gap-2">
                <span class="font-bold text-brand-400">1.</span>
                <span>フォームまたはLINEからお問い合わせ</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-brand-400">2.</span>
                <span>原則1営業日以内に担当よりご連絡</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-brand-400">3.</span>
                <span>オンライン（Zoom等）またはご来社にて課題ヒアリング（初回無料）</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-brand-400">4.</span>
                <span>課題整理と最適な改善プラン（顧問または構築）のご提案</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- フォーム本体 -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

      </div>
    </div>
  </section>
</Layout>
