---
import Layout from '../layouts/Layout.astro';
import { getLiveArticles } from '../data/articles';

const liveArticles = await getLiveArticles();

// A. 主軸サービス（MSTの中心商品）
const coreServices = [
  {
    num: '01',
    title: '経営戦略・利益改善顧問',
    badge: '主軸サービス',
    image: '/images/consulting-meeting.jpg',
    imageAlt: '経営戦略・利益改善のミーティング・課題棚卸し風景',
    desc: '経営者の右腕として、利益構造の改善・戦略立案といった経営面から、業務フローの属人化解消・効率化といった現場改善まで、会社全体を見渡して伴走します。',
    points: ['利益構造・採算の可視化と改善', '業務の属人化解消・標準化', '中長期の経営戦略・判断支援'],
    href: '/services/strategy',
  },
  {
    num: '02',
    title: '業務改善・IT・DX・AI顧問',
    badge: '主軸サービス',
    image: '/images/system-blueprint.jpg',
    imageAlt: 'パソコン画面での業務フロー設計図・IT/AI活用設計',
    desc: '業務プロセスの分析、属人化の解消、業務効率化、身の丈に合ったIT・DX・生成AI活用の設計と継続支援を行います。',
    points: ['業務フロー可視化・標準化', '現場の属人化ボトルネック解消', '身の丈に合ったIT・AI活用設計'],
    href: '/services/it-dx',
  },
];

// B. 主要サービス（顧問で設計した改善策を具体的に実装）
const implementationServices = [
  {
    num: '03',
    title: 'システム構築・業務自動化',
    badge: '主要サービス（実装）',
    desc: '業務フローや管理体制に合わせ、Google Workspace/GAS、専用Webアプリ、API連携により、手作業の削減や業務ミスの防止につながる仕組みを構築します。',
    href: '/services/system',
  },
  {
    num: '04',
    title: 'マーケティング戦略・集客導線構築',
    badge: '主要サービス（実装）',
    desc: 'ターゲット、商品、販売戦略に合わせて、認知から問い合わせ・成約までの導線を設計・構築。紹介頼みを脱却する集客基盤をつくります。',
    href: '/services/marketing',
  },
];

const steps = [
  {
    num: '01',
    title: '無料相談・現状ヒアリング',
    desc: 'まずはLINE、フォームからご連絡ください。現在の経営状況やお困りごとをお聞きします（初回無料）。',
  },
  {
    num: '02',
    title: '課題・目標の整理',
    desc: '数字や業務フローを棚卸しし、手元資金が残らない原因や業務の属人化ボトルネックを明確にします。',
  },
  {
    num: '03',
    title: '方針・改善案のご提案',
    desc: '貴社の予算やリソースに合わせた現実的な改善ロードマップ、顧問支援またはシステム構築のプランを提示。',
  },
  {
    num: '04',
    title: '顧問契約 または 構築支援開始',
    desc: 'ご納得いただいた上でご契約。顧問（設計・助言）と構築（実装）の区分を明確にして着手します。',
  },
  {
    num: '05',
    title: '実行・運用・継続改善',
    desc: '一度きりで終わらせず、月次ミーティングやシステム保守を通じて、利益が残る体制への定着を支援します。',
  },
];
---

<Layout
  title="有限会社MST | 経営の仕組み化で、利益が残る会社へ。"
  description="MST｜経営の仕組み化 × 利益改善。中小企業・小規模事業者の経営課題を整理し、利益改善につながる戦略と仕組みを設計。必要に応じてシステム構築や業務自動化まで、戦略と実行の両面から伴走支援します。"
>
  <!-- ① ファーストビュー -->
  <section class="relative bg-brand-950 text-white pt-20 pb-20 sm:pt-28 sm:pb-32 overflow-hidden">
    <!-- 背景画像レイヤー：打合せ・コンサルティング風景（参考例に準拠した高品位オーバーレイ） -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-consulting.jpg"
        alt="MST 経営の仕組み化と利益改善コンサルティング"
        class="w-full h-full object-cover object-right lg:object-center opacity-30 lg:opacity-40 mix-blend-luminosity filter contrast-125"
      />
      <!-- 深みのあるブランドネイビーのグラデーション（左側テキストの可読性と右側の洗練された雰囲気を両立） -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/95 sm:via-brand-950/90 to-brand-950/40 lg:to-brand-950/25"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-950/90 via-transparent to-brand-950"></div>
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#3984F5_1px,transparent_1px)] [background-size:24px_24px]"></div>
    </div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- 左側：キャッチコピー ＆ CTA（可読性と視認性を最優先） -->
        <div class="lg:col-span-7 space-y-6">
          <!-- ブランド表記 -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-900/90 border border-brand-400/40 text-brand-200 text-xs sm:text-sm font-medium backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            MST｜経営の仕組み化 × 利益改善
          </div>

          <!-- メインコピー（最も目立たせる） -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-serif tracking-tight leading-[1.3] sm:leading-[1.25] text-white drop-shadow-sm">
            経営の仕組み化で、<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 via-blue-200 to-brand-400">
              利益が残る会社
            </span>へ。
          </h1>

          <!-- 補足コピー -->
          <div>
            <p class="text-base sm:text-xl text-brand-200 font-medium">
              経営課題の解決から、新規事業の開発、仕組みの構築まで。
            </p>
          </div>

          <!-- CTA（優先順位を明確化：LINE相談を主CTA、無料診断を副CTAとして配置） -->
          <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
            <!-- 主CTA: LINEで無料相談する -->
            <a
              href="https://lin.ee/4Vl9v91"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 rounded-xl bg-[#06C755] hover:bg-[#05b34c] text-white font-bold text-sm sm:text-base text-center shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2.5 active:scale-[0.99]"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
              </svg>
              <span>LINEで無料相談する</span>
            </a>

            <!-- 副CTA: 3分無料経営診断 -->
            <a
              href="/diagnosis"
              class="px-8 py-4 rounded-xl bg-brand-900/90 hover:bg-brand-800/90 border border-brand-400/50 text-white font-semibold text-sm sm:text-base text-center shadow transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.99] backdrop-blur-md"
            >
              <span>3分無料経営診断</span>
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

          <!-- 支援内容説明文（CTA下の安心材料として配置） -->
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light pt-1 max-w-2xl">
            経営課題の整理から、利益改善の戦略設計、必要に応じたシステム構築・業務自動化まで。中小企業・小規模事業者の「経営の右腕」として、戦略と実行の両面から伴走します。
          </p>

          <!-- 提供価値バッジ -->
          <div class="pt-6 grid grid-cols-2 sm:grid-cols-3 gap-6 border-t border-brand-800/80 text-slate-300">
            <div>
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">実業主義</div>
              <div class="text-xs text-slate-400 mt-0.5">自社での事業運営・現場実践</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">戦略×実装</div>
              <div class="text-xs text-slate-400 mt-0.5">助言で終わらない仕組みづくり</div>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">伴走型</div>
              <div class="text-xs text-slate-400 mt-0.5">課題整理から運用定着まで一貫支援</div>
            </div>
          </div>
        </div>

        <!-- 右側：ビジュアル図解 ＆ システム設計図コクピットカード（PCのみ表示で縦長化を防止） -->
        <div class="hidden lg:block lg:col-span-5">
          <div class="bg-gradient-to-b from-white/10 to-slate-900/85 backdrop-blur-xl rounded-3xl border border-white/20 p-6 shadow-2xl space-y-5">
            
            <!-- コクピットヘッダー -->
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-brand-200 uppercase">MST ARCHITECTURE</span>
              </div>
              <span class="text-[11px] text-brand-300 bg-brand-900/80 border border-brand-500/30 px-2.5 py-0.5 rounded-full font-medium">
                仕組み化・システム設計図
              </span>
            </div>

            <!-- システム・設計図プレビュー画像コンテナ -->
            <div class="relative rounded-2xl overflow-hidden border border-brand-500/40 shadow-lg group">
              <img
                src="/images/system-blueprint.jpg"
                alt="パソコン画面での業務フロー設計図・システム自動化"
                class="w-full h-44 object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
              
              <!-- 画面内フローティングバッジ -->
              <div class="absolute top-2.5 right-2.5 bg-brand-950/85 backdrop-blur-md border border-brand-400/40 px-2.5 py-1 rounded-lg text-[10px] text-brand-200 font-semibold flex items-center gap-1.5 shadow">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                業務フロー・API連携稼働中
              </div>

              <!-- 画面内下部テキスト -->
              <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-white">
                <div>
                  <div class="text-[10px] text-brand-300 font-bold uppercase tracking-wider">PROCESS & DATA PIPELINE</div>
                  <div class="text-xs font-bold font-serif">属人化解消・月間工数40h削減の自動化設計</div>
                </div>
              </div>
            </div>

            <!-- ステップ図解ミニパイプライン -->
            <div class="grid grid-cols-3 gap-2 text-center">
              <div class="p-2.5 rounded-xl bg-slate-900/90 border border-brand-500/30">
                <div class="text-[10px] text-brand-300 font-bold">STEP 01</div>
                <div class="text-xs font-bold text-white mt-0.5">課題整理</div>
                <div class="text-[9px] text-slate-400 mt-0.5">採算・属人化分析</div>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900/90 border border-brand-500/30">
                <div class="text-[10px] text-brand-300 font-bold">STEP 02</div>
                <div class="text-xs font-bold text-white mt-0.5">設計図策定</div>
                <div class="text-[9px] text-slate-400 mt-0.5">業務標準化ロードマップ</div>
              </div>
              <div class="p-2.5 rounded-xl bg-brand-900/90 border border-brand-400/60 shadow">
                <div class="text-[10px] text-emerald-400 font-bold">STEP 03</div>
                <div class="text-xs font-bold text-white mt-0.5">仕組み実装</div>
                <div class="text-[9px] text-brand-200 mt-0.5">GAS / 専用Webアプリ</div>
              </div>
            </div>

            <div class="text-center text-[11px] text-slate-300 font-light pt-1">
              助言だけでなく、現場で動くシステム・業務フローを直接実装します
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ② 経営者が抱える課題 -->
  <section class="py-20 sm:py-28 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          CHALLENGES
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          こんな経営課題を抱えていませんか？
        </h2>
        <p class="text-sm sm:text-base text-gray-600">
          現場の頑張りだけでは解決できない「構造的なボトルネック」が会社の成長と利益を阻んでいます。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">売上はあるが利益が残らない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            忙しく働いているのに月末や決算期に手元キャッシュが薄い。案件ごとの正確な採算が把握できておらず、不採算業務が利益を圧迫しています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v-1m0 0a2 2 0 100-4m0 4V9"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">業務が属人化している</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            「あの人しか分からない」業務ばかりで、担当者が休むと業務がストップ。マニュアルが形骸化し、新人育成にも多大なコストがかかっています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">集客が安定しない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            来月や3ヶ月後の見込み客獲得が紹介や人脈頼み。HPやSNSはあるものの、実際の問い合わせや商談に繋がる導線が機能していません。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">日々の業務に追われ改善が進まない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            社長自身が現場実務やトラブル対応に忙殺され、中長期の経営戦略や新規事業、仕組みづくりに向き合う時間が取れていません。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">IT・AIを活用したいが何から始めればよいか不明</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            世の中のDXツールやAIは難解で、自社にどう当てはまるか分からない。高いシステムを入れても使いこなせず放置される懸念を抱えています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-400 hover:shadow-lg transition">
          <div class="w-12 h-12 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">新しい事業を始めたいが仕組みづくりに不安</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            新たな収益の柱を作りたいが、企画、集客、業務フロー、現場オペレーションを一から構築するリソースや知見が社内に不足しています。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ MSTの提供価値と支援方針 -->
  <section class="py-20 sm:py-28 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          OUR POLICY
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          MSTの提供価値と支援方針
        </h2>
        <p class="text-sm sm:text-base text-gray-600">
          改善を一度きりで終わらせず、継続的な成長につなげる4段階のアプローチ。
        </p>
      </div>

      <!-- 打合せ風景 ＆ パソコン画面での仕組み化・設計図の2大実践ビジュアル -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white rounded-2xl border border-sand-300 overflow-hidden shadow-sm hover:shadow-md transition group">
          <div class="relative h-48 sm:h-56 overflow-hidden">
            <img
