    alt: 'パソコン画面での業務フロー設計図・システム自動化設計',
    caption: 'WORKFLOW & ARCHITECTURE',
  },
  {
    image: '/images/service-system.jpg',
    alt: 'GAS・専用Webアプリ・API連携の直接開発・実装',
    caption: 'BESPOKE AUTOMATION',
  },
  {
    image: '/images/service-it-dx.jpg',
    alt: '現場のIT・DX・生成AIワークフロー運用定着支援',
    caption: 'DX & AI INTEGRATION',
  },
];

// A. 主軸サービス（MSTの中心商品）
const coreServices = [
  {
    num: '01',
    title: '経営戦略・利益改善顧問',
    badge: '主軸サービス',
    image: '/images/service-strategy.jpg',
    imageAlt: '経営戦略・利益構造分析と意思決定支援の顧問セッション風景',
    desc: '経営者の右腕として、利益構造の改善・戦略立案といった経営面から、業務フローの属人化解消・効率化といった現場改善まで、会社全体を見渡して伴走します。',
    points: ['利益構造・採算の可視化と改善', '業務の属人化解消・標準化', '中長期の経営戦略・判断支援'],
    href: '/services/strategy',
  },
  {
    num: '02',
