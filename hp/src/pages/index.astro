---
import Layout from '../layouts/Layout.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
import { getLiveArticles } from '../data/articles';

const liveArticles = await getLiveArticles();

// ファーストビュー背景用スライドショー（高精細ズーム＆クロスフェード）
const heroSlides = [
  {
    image: '/images/hero-consulting.jpg',
    alt: 'MST 経営戦略・利益改善コンサルティングミーティング',
    caption: 'STRATEGY & ADVISORY',
  },
  {
    image: '/images/system-blueprint.jpg',
    alt: 'パソコン画面での業務フロー設計図・システム自動化設計',
    caption: 'WORKFLOW & ARCHITECTURE',
  },
  {
    image: '/images/service-system.jpg',
    alt: 'GAS・専用Webアプリ・API連携の直接開発・実装',
    caption: 'BESPOKE AUTOMATION',
  },
  {
    image: '/images/service-it-dx.jpg',
    alt: '現場のIT・DX・生成AIワークフロー運用定着支援',
    caption: 'DX & AI INTEGRATION',
  },
];

// 4大主力支援メニュー（顧問 ＆ 実装構築）
const allServices = [
  {
    num: '01',
    category: '主力顧問',
    title: '経営戦略・利益改善顧問',
    badge: '経営・粗利改善',
    image: '/images/service-strategy.jpg',
    imageAlt: '経営戦略・利益構造分析と意思決定支援の顧問セッション風景',
    desc: '社長の右腕として、案件別・現場別の粗利管理や採算構造の可視化を支援。どんぶり勘定から脱却し、利益が確実に残る意思決定体制をつくります。',
    target: '建設・工事・清掃・請負など、「忙しいのに手元にお金が残らない」「案件ごとの原価が正確に掴めない」企業様',
    href: '/services/strategy',
  },
  {
    num: '02',
    category: '主力顧問',
    title: '業務改善・IT・DX・AI顧問',
    badge: '属人化・業務標準化',
    image: '/images/service-it-dx.jpg',
    imageAlt: '現場のIT・DX・生成AIワークフロー設計と運用定着支援風景',
    desc: '業務プロセスの棚卸しと標準化を行い、社長や特定スタッフへの依存を解消。身の丈に合ったIT・AI活用と現場の自走定着を継続支援します。',
    target: '「社長が現場管理から事務まで兼任してパンクしている」「社員が増えても業務が回らない」現場・人材活用型企業様',
    href: '/services/it-dx',
  },
  {
    num: '03',
    category: '構築・実行支援',
    title: 'システム構築・業務自動化',
    badge: '手作業・二重転記ゼロ',
    image: '/images/service-system.jpg',
    imageAlt: 'GAS・専用Webアプリ・API連携による業務自動化システムの開発風景',
    desc: 'Googleスプレッドシート/GASから現場専用Webアプリ、API連携まで。Excelやツールの分断を解消し、手作業・二重転記をゼロにする仕組みを直接開発。',
    target: '「既存システムはあるが連携していない」「現場と事務所で二重入力が発生している」企業様',
    href: '/services/system',
  },
  {
    num: '04',
    category: '集客・LTV改善',
    title: 'マーケティング・集客導線構築',
    badge: '自社集客・LINE自動化',
    image: '/images/service-marketing.jpg',
    imageAlt: 'マルチチャネル集客・公式LINE・成約ファネルの導線設計風景',
    desc: 'ポータルサイトや紹介頼みから脱却し、LINE公式・Web集客・成約ファネルを設計。見込み客獲得からリピート・LTV向上までを仕組み化します。',
    target: 'エステ・美容・整体・ジムなど、「広告費が高止まりしている」「リピート率を高めたい」店舗型サービス企業様',
    href: '/services/marketing',
  },
];

// 主な支援対象業界（重点5大業種）
const targetIndustries = [
  {
    category: '工事業',
    title: '建設・設備・リフォームなどの工事業',
    sub: '建築 / 設備工事 / 電気工事 / 塗装 / リフォーム / 内装 / 外構など',
    icon: '🏗️',
    issues: [
      '月末や決算を迎えるまで案件ごとの粗利がわからない',
      '材料費・外注費・現場工数が分散しリアルタイム管理できない',
      '見積もり・受注・施工・請求で二重入力や転記ミスが頻発する',
    ],
    solution: '案件別原価・粗利の可視化 ＆ 見積〜請求データ連携による手作業ゼロ化',
  },
  {
    category: '店舗サービス業',
    title: 'エステ・美容・整体などの店舗型サービス業',
    sub: 'エステ・脱毛 / 美容室・理容室 / 整体・接骨院 / パーソナルジム等（※複数店舗・スタッフ雇用企業）',
    icon: '💆',
    badge: '代表自らもエステサロンを直営・現役経営中',
    issues: [
      '大手集客ポータルに依存し、高い広告掲載料・手数料が重い',
      '問い合わせから来店までの導線やLINEフォローが仕組み化されていない',
      'スタッフ別・店舗別の売上や稼働率、利益管理が属人化している',
    ],
    solution: '自社集客導線（Web・LINE自動化）の構築 ＆ リピート率・LTV改善（自社サロンでの検証済みノウハウ）',
  },
  {
    category: '清掃・保守業',
    title: '清掃・メンテナンス業',
    sub: 'ビル清掃 / ハウスクリーニング / 住宅管理 / 建物メンテナンス / 設備点検',
    icon: '🧹',
    issues: [
      '定期契約とスポット案件のスケジュール調整・スタッフ配置が煩雑',
      '現場ごとの収益・スタッフ稼働率が把握できていない',
      '作業報告・検収・請求業務が紙や手作業でタイムラグが大きい',
    ],
    solution: '定期契約・人員稼働の一元管理 ＆ スマホ報告・請求自動連動',
  },
  {
    category: '介護・福祉業',
    title: '介護・福祉・生活支援業',
    sub: '介護事業 / 訪問系サービス / 生活支援 / 介護保険外サービス等',
    icon: '🤝',
    issues: [
      '人員配置やシフト・稼働率の管理が逼迫している',
      '記録・報告・事務作業に追われ、本来のケアや人材育成に時間が割けない',
      '制度改正に左右されない「第2の収益の柱」や新規事業の立ち上げ課題',
    ],
    solution: '業務標準化・効率化 ＆ 介護保険外生活支援パッケージによる新規事業開発',
  },
  {
    category: '専門請負業',
    title: '専門サービス・作業請負業',
    sub: '造園 / 害虫駆除 / 特殊清掃 / 設備点検 / 各種専門作業請負など',
    icon: '🛠️',
    issues: [
      '案件ごとの見積もりや原価・利益の計算が社長の頭の中にしかない',
      '職人・スタッフごとの作業手順が属人化し、業務標準化が進まない',
      '過去の顧客履歴や保守・点検履歴が引き継がれず機会損失が発生',
    ],
    solution: '見積・原価ロジックの標準化 ＆ 顧客・案件台帳のクラウド一元管理',
  },
];

const steps = [
  {
    num: '01',
    title: '無料診断・無料ヒアリング',
    desc: 'まずは3分無料診断またはフォーム/LINEよりご連絡ください。現在の経営状況や業務の分断箇所を整理します（初回無料）。',
  },
  {
    num: '02',
    title: 'ボトルネックの特定と数値化',
    desc: '案件別採算・業務フロー・情報管理の課題を棚卸しし、利益が残らない原因や社長依存の急所を明確にします。',
  },
  {
    num: '03',
    title: '改善方針・現実的ロードマップのご提案',
    desc: '貴社の予算やリソースに合わせ、まずは業務整理・標準化から着手する顧問プラン、または必要に応じた構築プランを提示。',
  },
  {
    num: '04',
    title: '顧問契約 または 構築着手',
    desc: 'ご納得いただいた上でスタート。助言・設計（顧問）とツール開発（構築）の区分を明確にし、透明性高く進めます。',
  },
  {
    num: '05',
    title: '現場定着・月次改善・自走化',
    desc: '一度きりで終わらせず、月次ミーティングを通じて現場が自走し、利益が手元に残る体質への定着を支援します。',
  },
];
---

<Layout
  title="有限会社MST | 経営の仕組み化で、利益が残る会社へ。"
  description="MST｜経営の仕組み化 × 利益改善。建設・工事業、清掃、介護、店舗サービス業などの経営課題を整理し、粗利管理・業務標準化・自動化で利益体質化を実現。戦略から現場実装まで一気通貫で伴走します。"
>
  <!-- ① ファーストビュー（情報過多を解消：3秒で伝わるキャッチ＋サブ＋主CTA） -->
  <section class="relative bg-brand-950 text-white pt-24 pb-20 sm:pt-32 sm:pb-32 overflow-hidden min-h-[580px] lg:min-h-[640px] flex items-center">
    
    <!-- 背景スライドショーコンテナ（高精細ズーム＆クロスフェード） -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-slider-container">
      {heroSlides.map((slide, idx) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10 active-slide' : 'opacity-0 z-0'}`}
          data-slide-index={idx}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            class="hero-slide-img w-full h-full object-cover object-right lg:object-center filter contrast-105 brightness-95 transition-transform duration-[6000ms] ease-out"
          />
        </div>
      ))}
      
      <!-- テキスト可読性グラデーションオーバーレイ -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/95 via-brand-950/75 to-brand-950/30 z-20 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-950/50 via-transparent to-brand-950/90 z-20 pointer-events-none"></div>
    </div>

    <!-- 光彩ブラー装飾 -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none z-10"></div>
    <div class="absolute top-1/2 right-1/4 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none z-10"></div>

    <div class="relative z-30 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- 左側：キャッチコピー ＆ メインCTA（3秒で誰の何を解決するか伝える） -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- ターゲット明示バッジ -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-900/90 border border-brand-400/40 text-brand-200 text-xs sm:text-sm font-medium backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>現場・店舗サービス業専門｜経営の仕組み化 × 利益改善パートナー</span>
          </div>

          <!-- メインキャッチコピー -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-serif tracking-tight leading-[1.25] sm:leading-[1.2] text-white drop-shadow-sm">
            経営の仕組み化で、<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-200 to-amber-400">
              利益が残る会社
            </span>へ。
          </h1>

          <!-- サブコピー（過度な圧迫感を排し、共感と安心感のある問いかけへ） -->
          <div class="space-y-2.5">
            <p class="text-base sm:text-lg font-bold text-amber-200 font-serif">
              業務の属人化や、利益・管理体制の仕組み化に悩む経営者様へ。
            </p>
            <p class="text-xs sm:text-sm text-slate-200 font-light leading-relaxed max-w-xl">
              社長依存やExcel・手作業の分散管理から脱却。<br class="hidden sm:inline" />
              粗利の見える化と業務プロセスの標準化で、現場が自走し「利益が手元に残る組織」をつくります。
            </p>
          </div>

          <!-- CTAエリア（メインCTAを「無料経営ボトルネック診断」に一本化） -->
          <div class="pt-2 space-y-3">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
              <!-- 主CTA: 無料経営ボトルネック診断 -->
              <a
                href="/diagnosis"
                class="px-8 py-4 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-black text-sm sm:text-base text-center shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all duration-200 flex items-center justify-center gap-2.5 active:scale-[0.99] group"
              >
                <span>無料経営ボトルネック診断（3分・全5問）</span>
                <svg class="w-4 h-4 shrink-0 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <!-- 副導線: 個別相談・お問い合わせ -->
              <a
                href="/contact"
                class="px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-medium text-xs sm:text-sm text-center shadow transition-all duration-200 flex items-center justify-center gap-2 backdrop-blur-md active:scale-[0.99]"
              >
                <span>個別相談・お問い合わせ</span>
              </a>
            </div>

            <!-- 安心の注記（シンプルに1行で安心感を提示） -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] sm:text-xs text-slate-300 pt-1 font-light">
              <span class="flex items-center gap-1">✓ 登録不要・その場で結果判定</span>
              <span class="flex items-center gap-1">✓ 強引な営業は一切行いません</span>
              <span class="flex items-center gap-1">✓ 全国オンライン対応</span>
            </div>
          </div>

        </div>

        <!-- 右側：シンプルな仕組み化プレビューカード（要素過多を解消し1枚に凝縮） -->
        <div class="hidden lg:block lg:col-span-5">
          <div class="bg-gradient-to-b from-white/10 to-slate-900/90 backdrop-blur-xl rounded-3xl border border-white/20 p-6 shadow-2xl space-y-4">
            
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-brand-200 uppercase">MST BUSINESS ARCHITECTURE</span>
              </div>
              <span class="text-[11px] text-amber-300 bg-amber-950/80 border border-amber-500/40 px-2.5 py-0.5 rounded-full font-medium">
                利益改善 × 自動化設計
              </span>
            </div>

            <div class="relative rounded-2xl overflow-hidden border border-brand-500/40 shadow-lg group">
              <img
                src="/images/system-blueprint.jpg"
                alt="パソコン画面での業務フロー設計図・システム自動化"
                class="w-full h-52 object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
              
              <div class="absolute top-3 right-3 bg-brand-950/85 backdrop-blur-md border border-brand-400/40 px-2.5 py-1 rounded-lg text-[10px] text-brand-200 font-semibold flex items-center gap-1.5 shadow">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                案件・原価・顧客データ連動中
              </div>

              <div class="absolute bottom-3 left-3 right-3 text-white">
                <div class="text-[10px] text-brand-300 font-bold uppercase tracking-wider">PROCESS & PROFIT PIPELINE</div>
                <div class="text-sm font-bold font-serif">属人化解消・月間工数40h削減の自動化設計</div>
              </div>
            </div>

            <div class="p-3 rounded-xl bg-slate-900/90 border border-brand-500/30 text-xs text-slate-300 leading-relaxed font-light text-center">
              助言（コンサル）だけでなく、現場で動くシステム・業務フローを直接実装します
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ①-B MSTが選ばれる3つの強み（FVから切り出し、ゆったりと配置） -->
  <section class="py-12 sm:py-16 bg-brand-900 border-b border-brand-800 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <div class="bg-brand-950/70 p-6 sm:p-7 rounded-2xl border border-brand-700/60 shadow-md space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-400 tracking-wider">STRENGTH 01</span>
            <span class="text-lg">🏢</span>
          </div>
          <div class="text-xl font-bold font-serif text-white">実業主義</div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light">
            自社でも事業を創業・経営しているからこそ、机上の空論ではない「現場の生々しい実態」に即した実現可能な解決策を提示します。
          </p>
          <div class="flex items-center gap-3 pt-2.5 border-t border-brand-800/80">
            <img
              src="/images/representative.webp"
              alt="有限会社MST 代表取締役 大橋真人"
              class="w-9 h-9 rounded-full object-cover border border-amber-400/60 shadow shrink-0"
              width="36"
              height="36"
            />
            <div class="text-[11px] leading-tight text-slate-300">
              <span class="font-bold text-white block">代表 大橋 真人</span>
              <span class="text-amber-300">自らもエステサロンや生活支援事業を現役経営・伴走</span>
            </div>
          </div>
        </div>

        <div class="bg-brand-950/70 p-6 sm:p-7 rounded-2xl border border-brand-700/60 shadow-md space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-400 tracking-wider">STRENGTH 02</span>
            <span class="text-lg">⚙️</span>
          </div>
          <div class="text-xl font-bold font-serif text-white">助言 × 現場実装</div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light">
            口を出すだけで終わらせず、GAS・専用Webアプリ・API連携など、現場で実際に機能する仕組みまで自ら手を動かして開発・実装します。
          </p>
        </div>

        <div class="bg-brand-950/70 p-6 sm:p-7 rounded-2xl border border-brand-700/60 shadow-md space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-400 tracking-wider">STRENGTH 03</span>
            <span class="text-lg">🤝</span>
          </div>
          <div class="text-xl font-bold font-serif text-white">伴走型定着</div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light">
            作って終わりにせず、現場の従業員が迷わず自走できるまで粘り強く伴走。属人化を根本から防ぎ、継続して利益が残る体制をつくります。
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ①-C 主な対象業界（5大重点業種） -->
  <section class="py-16 sm:py-24 bg-sand-50 border-b border-sand-200 relative">
