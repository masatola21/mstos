  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.hero-slide');
      if (!slides.length) return;

      let currentIdx = 0;
      const total = slides.length;
      const intervalMs = 5000;

      const firstImg = slides[0].querySelector('.hero-slide-img');
      if (firstImg) {
        firstImg.style.transform = 'scale(1.08)';
      }

      setInterval(() => {
        const nextIdx = (currentIdx + 1) % total;

        slides[currentIdx].classList.remove('opacity-100', 'z-10', 'active-slide');
        slides[currentIdx].classList.add('opacity-0', 'z-0');
        const curImg = slides[currentIdx].querySelector('.hero-slide-img');
        if (curImg) {
          curImg.style.transform = 'scale(1.0)';
        }

        slides[nextIdx].classList.remove('opacity-0', 'z-0');
        slides[nextIdx].classList.add('opacity-100', 'z-10', 'active-slide');
        const nextImg = slides[nextIdx].querySelector('.hero-slide-img');
        if (nextImg) {
          nextImg.style.transform = 'scale(1.08)';
        }

        currentIdx = nextIdx;
      }, intervalMs);
    });
  </script>

