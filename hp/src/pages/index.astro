const steps = [
  {
    num: '01',
    title: '無料相談・現状ヒアリング',
    desc: 'まずはLINE、フォームからご連絡ください。現在の経営状況やお困りごとをお聞きします（初回無料）。',
  },
  {
    num: '02',
    title: '課題・目標の整理',
    desc: '数字や業務フローを棚卸しし、手元資金が残らない原因や業務の属人化ボトルネックを明確にします。',
  },
  {
    num: '03',
    title: '方針・改善案のご提案',
    desc: '貴社の予算やリソースに合わせた現実的な改善ロードマップ、顧問支援またはシステム構築のプランを提示。',
  },
  {
    num: '04',
    title: '顧問契約 または 構築支援開始',
    desc: 'ご納得いただいた上でご契約。顧問（戦略・効率化設計・助言）と構築（システム・ツール実装）の区分を明確にして着手します。',
  },
  {
    num: '05',
    title: '実行・運用・継続改善',
    desc: '一度きりで終わらせず、月次ミーティングやシステム保守を通じて、利益が残る体制への定着を支援します。',
  },
];
---

<Layout
  title="有限会社MST | 経営の仕組み化で、利益が残る会社へ。"
  description="MST｜経営の仕組み化 × 利益改善。中小企業・小規模事業者の経営課題を整理し、利益改善につながる戦略と仕組みを設計。必要に応じてシステム構築や業務自動化まで、戦略と実行の両面から伴走支援します。"
>
  <!-- ① ファーストビュー（OWNERSONE-WITH風 背景クロスフェード＆ズーム + AUTORO風 動的自動化コクピット） -->
  <section class="relative bg-brand-950 text-white pt-20 pb-20 sm:pt-28 sm:pb-32 overflow-hidden min-h-[640px] flex items-center">
    
    <!-- 背景スライドショーコンテナ（OWNERSONE風：100%くっきり鮮明なフルカラー高精細スライダー） -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-slider-container">
      {heroSlides.map((slide, idx) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10 active-slide' : 'opacity-0 z-0'}`}
          data-slide-index={idx}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            class="hero-slide-img w-full h-full object-cover object-right lg:object-center filter contrast-105 brightness-95 transition-transform duration-[6000ms] ease-out"
          />
        </div>
      ))}
      
      <!-- 左側テキストの背景のみ濃くし、写真全体は本来のコントラスト・色味を100%ダイレクトに見せる設計 -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/90 via-brand-950/50 to-transparent z-20 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-brand-950/40 via-transparent to-brand-950/80 z-20 pointer-events-none"></div>
    </div>

    <!-- インフォディオ風の洗練された光彩ブラー -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/25 rounded-full blur-3xl pointer-events-none z-10"></div>
    <div class="absolute top-1/2 right-1/4 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none z-10"></div>

    <div class="relative z-30 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- 左側：キャッチコピー ＆ CTA（可読性と視認性を最優先） -->
        <div class="lg:col-span-7 space-y-6">
          <!-- ブランド表記 ＆ スライドインジケーター連動バッジ -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-900/90 border border-brand-400/40 text-brand-200 text-xs sm:text-sm font-medium backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>MST｜経営の仕組み化 × 利益改善</span>
            <span class="text-[10px] text-brand-300 font-mono pl-1 border-l border-brand-600/60" id="hero-slide-counter">01 / 04</span>
          </div>

          <!-- メインコピー（最も目立たせる） -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-serif tracking-tight leading-[1.3] sm:leading-[1.25] text-white drop-shadow-sm">
            経営の仕組み化で、<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 via-blue-200 to-brand-400">
              利益が残る会社
            </span>へ。
          </h1>

          <!-- 補足コピー -->
          <div>
            <p class="text-base sm:text-xl text-brand-200 font-medium">
              経営課題の解決から、新規事業の開発、仕組みの構築まで。
            </p>
          </div>

          <!-- CTA（優先順位を明確化：LINE相談を主CTA、無料診断を副CTAとして配置） -->
          <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
            <!-- 主CTA: LINEで無料相談する -->
            <a
              href="https://lin.ee/qWsuD6f"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 rounded-xl bg-[#06C755] hover:bg-[#05b34c] text-white font-bold text-sm sm:text-base text-center shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2.5 active:scale-[0.99]"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
              </svg>
              <span>LINEで無料相談する</span>
            </a>

            <!-- 副CTA: 3分無料経営診断 -->
            <a
              href="/diagnosis"
              class="px-8 py-4 rounded-xl bg-brand-900/90 hover:bg-brand-800/90 border border-brand-400/50 text-white font-semibold text-sm sm:text-base text-center shadow transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.99] backdrop-blur-md"
            >
              <span>3分無料経営診断</span>
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

          <!-- 支援内容説明文（CTA下の安心材料として配置） -->
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light pt-1 max-w-2xl">
            経営課題の整理から、利益改善の戦略設計、必要に応じたシステム構築・業務自動化まで。中小企業・小規模事業者の「経営の右腕」として、戦略と実行の両面から伴走します。
          </p>

          <!-- 提供価値バッジ -->
          <div class="pt-6 grid grid-cols-2 sm:grid-cols-3 gap-6 border-t border-brand-800/80 text-slate-300">
            <div>
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">実業主義</div>
              <div class="text-xs text-slate-400 mt-0.5">自社での事業運営・現場実践</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">戦略×実装</div>
              <div class="text-xs text-slate-400 mt-0.5">助言で終わらない仕組みづくり</div>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <div class="text-xl sm:text-2xl font-bold font-serif text-brand-300">伴走型</div>
              <div class="text-xs text-slate-400 mt-0.5">課題整理から運用定着まで一貫支援</div>
            </div>
          </div>
        </div>

        <!-- 右側：ビジュアル図解 ＆ AUTORO風 動く自動化コクピット（PCのみ表示で縦長化を防止） -->
        <div class="hidden lg:block lg:col-span-5">
          <div class="bg-gradient-to-b from-white/10 to-slate-900/85 backdrop-blur-xl rounded-3xl border border-white/20 p-6 shadow-2xl space-y-5">
            
            <!-- コクピットヘッダー -->
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-bold tracking-widest text-brand-200 uppercase">MST ARCHITECTURE</span>
              </div>
              <span class="text-[11px] text-brand-300 bg-brand-900/80 border border-brand-500/30 px-2.5 py-0.5 rounded-full font-medium">
                仕組み化・システム設計図
              </span>
            </div>

            <!-- システム・設計図プレビュー画像コンテナ -->
            <div class="relative rounded-2xl overflow-hidden border border-brand-500/40 shadow-lg group">
              <img
                src="/images/system-blueprint.jpg"
                alt="パソコン画面での業務フロー設計図・システム自動化"
                class="w-full h-44 object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
              
              <!-- 画面内フローティングバッジ（動的インジケーター） -->
              <div class="absolute top-2.5 right-2.5 bg-brand-950/85 backdrop-blur-md border border-brand-400/40 px-2.5 py-1 rounded-lg text-[10px] text-brand-200 font-semibold flex items-center gap-1.5 shadow">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                業務フロー・API連携稼働中
              </div>

              <!-- 画面内下部テキスト -->
              <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-white">
                <div>
                  <div class="text-[10px] text-brand-300 font-bold uppercase tracking-wider">PROCESS & DATA PIPELINE</div>
                  <div class="text-xs font-bold font-serif">属人化解消・月間工数40h削減の自動化設計</div>
                </div>
              </div>
            </div>

            <!-- AUTORO風：受け取る・読み取る・判断する・実行する のパイプライン連動ステップ -->
            <div class="grid grid-cols-3 gap-2 text-center relative">
              <div class="p-2.5 rounded-xl bg-slate-900/90 border border-brand-500/30 transition-all duration-300 hover:border-brand-400">
                <div class="text-[10px] text-brand-300 font-bold">STEP 01</div>
                <div class="text-xs font-bold text-white mt-0.5">課題整理</div>
                <div class="text-[9px] text-slate-400 mt-0.5">採算・属人化分析</div>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900/90 border border-brand-500/30 transition-all duration-300 hover:border-brand-400">
                <div class="text-[10px] text-brand-300 font-bold">STEP 02</div>
                <div class="text-xs font-bold text-white mt-0.5">設計図策定</div>
                <div class="text-[9px] text-slate-400 mt-0.5">業務標準化ロードマップ</div>
              </div>
              <div class="p-2.5 rounded-xl bg-brand-900/90 border border-brand-400/60 shadow transition-all duration-300 hover:scale-[1.02]">
                <div class="text-[10px] text-emerald-400 font-bold">STEP 03</div>
                <div class="text-xs font-bold text-white mt-0.5">仕組み実装</div>
                <div class="text-[9px] text-brand-200 mt-0.5">GAS / 専用Webアプリ</div>
              </div>
            </div>

            <!-- スライドバー・インジケーター（OWNERSONE風のプログレスバー） -->
            <div class="space-y-1.5 pt-1">
              <div class="flex items-center justify-between text-[10px] text-slate-400">
                <span>SYSTEM & CONSULTING REALTIME</span>
                <span class="text-brand-300 font-mono">AUTORUNNING</span>
              </div>
              <div class="w-full bg-slate-800 rounded-full h-1 overflow-hidden">
                <div class="bg-gradient-to-r from-brand-400 via-cyan-400 to-emerald-400 h-1 rounded-full animate-pulse" id="hero-progress-bar" style="width: 25%; transition: width 0.5s ease-in-out;"></div>
              </div>
            </div>

            <div class="text-center text-[11px] text-slate-300 font-light pt-0.5">
              助言だけでなく、現場で動くシステム・業務フローを直接実装します
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- OWNERSONE風 スライドショースクリプト（Ken Burns ズーム ＆ 自動クロスフェード） -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.hero-slide');
      const counter = document.getElementById('hero-slide-counter');
      const progressBar = document.getElementById('hero-progress-bar');
      if (!slides.length) return;

      let currentIdx = 0;
      const total = slides.length;
      const intervalMs = 5000;

      // 最初のスライドにズームインクラスを付与
      const firstImg = slides[0].querySelector('.hero-slide-img');
      if (firstImg) {
        firstImg.style.transform = 'scale(1.08)';
      }

      setInterval(() => {
        const nextIdx = (currentIdx + 1) % total;

        // 現在のスライドをフェードアウト
        slides[currentIdx].classList.remove('opacity-100', 'z-10', 'active-slide');
        slides[currentIdx].classList.add('opacity-0', 'z-0');
        const curImg = slides[currentIdx].querySelector('.hero-slide-img');
        if (curImg) {
          curImg.style.transform = 'scale(1.0)';
        }

        // 次のスライドをフェードイン ＆ ゆっくりズームイン
        slides[nextIdx].classList.remove('opacity-0', 'z-0');
        slides[nextIdx].classList.add('opacity-100', 'z-10', 'active-slide');
        const nextImg = slides[nextIdx].querySelector('.hero-slide-img');
        if (nextImg) {
          nextImg.style.transform = 'scale(1.08)';
        }

        currentIdx = nextIdx;

        // カウンターとプログレスバーを更新
        if (counter) {
          counter.textContent = `0${currentIdx + 1} / 0${total}`;
        }
        if (progressBar) {
          progressBar.style.width = `${((currentIdx + 1) / total) * 100}%`;
        }
      }, intervalMs);
    });
  </script>

  <!-- ② 経営者が抱える課題（OWNERSONE-WITH風：Before ➔ After 構造改革対比） -->
  <section class="py-20 sm:py-28 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          BEFORE & AFTER
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          現場の頑張り頼みから、<br class="hidden sm:inline" />利益が自動で残る「仕組み経営」へ。
        </h2>
        <p class="text-sm sm:text-base text-gray-600">
          多くの企業が直面する3大ボトルネックを、MSTの【戦略設計 × 現場実装】で根本解決します。
        </p>
      </div>

      <!-- Before / After 対比グリッドカード -->
      <div class="space-y-8 max-w-5xl mx-auto">
        
        <!-- 対比 1: 利益・採算 -->
        <div class="bg-sand-50 rounded-2xl border border-sand-300 p-6 sm:p-8 shadow-sm">
          <div class="text-xs font-bold text-brand-800 bg-brand-100/80 px-3 py-1 rounded-md inline-block mb-4">
            構造改革 01｜利益・資金繰り
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
            <!-- BEFORE -->
            <div class="bg-red-50/70 rounded-xl p-5 border border-red-200 flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-xs font-bold text-red-700">
                  <span class="w-5 h-5 rounded-full bg-red-200 flex items-center justify-center text-red-800 font-bold">✕</span>
                  <span>従来の現場（BEFORE）</span>
                </div>
                <h3 class="text-base font-bold text-slate-900">売上はあるのに手元資金が残らない</h3>
                <p class="text-xs text-gray-600 leading-relaxed">
                  案件や部門ごとの正確な採算が把握できず、忙しく動いているのに月末の手元キャッシュが薄い。不採算業務が利益を圧迫している。
                </p>
              </div>
              <div class="text-[11px] text-red-600 font-medium mt-3 pt-2 border-t border-red-200/60">
                リスク：値上げや投資判断ができず、ジリ貧が続く
              </div>
            </div>
            <!-- AFTER -->
            <div class="bg-emerald-50/70 rounded-xl p-5 border border-emerald-200 flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-xs font-bold text-emerald-700">
                  <span class="w-5 h-5 rounded-full bg-emerald-200 flex items-center justify-center text-emerald-800 font-bold">✓</span>
                  <span>MST伴走後（AFTER）</span>
                </div>
