---
import Layout from '../layouts/Layout.astro';
import { ARTICLES } from '../data/articles';

const services = [
  {
    num: '01',
    title: '経営戦略・利益改善顧問',
    desc: '経営課題を整理し、利益構造・収益性を改善。売上はあるが利益が残らない企業に伴走。',
    href: '/services/strategy',
  },
  {
    num: '02',
    title: '業務改善・IT・DX・AI顧問',
    desc: '業務の非効率・属人化を解消。身の丈に合ったツール選定・AI活用・マニュアル化を支援。',
    href: '/services/it-dx',
  },
  {
    num: '03',
    title: 'システム構築・業務自動化',
    desc: 'Google Workspace/GAS、専用Webアプリ、API連携で手作業をゼロにし、ミスをなくす実装開発。',
    href: '/services/system',
  },
  {
    num: '04',
    title: 'マーケティング・集客導線構築',
    desc: '紹介頼みを脱却。強みの言語化からLP制作、LINE公式アカウント、見込み客育成までを設計。',
    href: '/services/marketing',
  },
  {
    num: '05',
    title: '新規事業企画・立ち上げ支援',
    desc: '既存事業に次ぐ第2の収益の柱を構築。商品設計、収益モデル、業務体制をパッケージ化。',
    href: '/services/new-business',
  },
  {
    num: '06',
    title: '介護保険外サービス開業パッケージ',
    desc: '「新しい事業を、ゼロから作らない。」自社直営事業「アシスタ大垣」の実証基盤をそのまま提供。',
    href: '/services/care-package',
  },
];

const steps = [
  {
    num: '01',
    title: '無料相談・現状ヒアリング',
    desc: 'まずはLINE、フォームからご連絡ください。現在の経営状況やお困りごとをお聞きします（初回無料）。',
  },
  {
    num: '02',
    title: '課題・目標の整理',
    desc: '数字や業務フローを棚卸しし、手元資金が残らない原因や業務の属人化ボトルネックを明確にします。',
  },
  {
    num: '03',
    title: '方針・改善案のご提案',
    desc: '貴社の予算やリソースに合わせた現実的な改善ロードマップ、顧問支援またはシステム構築のプランを提示。',
  },
  {
    num: '04',
    title: '顧問契約 または 構築支援開始',
    desc: 'ご納得いただいた上でご契約。顧問（設計・助言）と構築（実装）の区分を明確にして着手します。',
  },
  {
    num: '05',
    title: '実行・運用・継続改善',
    desc: '一度きりで終わらせず、月次ミーティングやシステム保守を通じて、確実に利益が残る体制へ定着させます。',
  },
];
---

<Layout
  title="有限会社MST | 経営の仕組み化で、利益が残る会社へ。"
  description="中小企業・小規模事業者の成長と改善を、戦略と実行の両面から支援する「経営の右腕」パートナー。利益改善顧問、業務自動化、AI経営OS導入、介護保険外サービス開業支援まで。"
>
  <!-- ① メインビジュアル -->
  <section class="relative bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white pt-20 pb-24 sm:pt-28 sm:pb-36 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3984F5_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-800/80 border border-brand-500/30 text-brand-200 text-xs font-semibold backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
          経営戦略 × IT・DX × 現場実装
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-serif tracking-tight leading-[1.25] text-white">
          経営の仕組み化で、<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 via-blue-200 to-brand-400">
            利益が残る会社
          </span>へ。
        </h1>

        <p class="text-base sm:text-xl text-slate-200 leading-relaxed font-light">
          中小企業・小規模事業者の成長と改善を、戦略と実行の両面から支援します。<br class="hidden sm:inline" />
          MSTは単なるIT導入・開発会社ではなく、経営課題を整理し、改善策を設計し、必要に応じて実装まで支援する「経営の右腕」です。
        </p>

        <!-- 設計書指定のアクションボタン: LINE相談 ＆ 無料診断 -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="https://lin.ee/4Vl9v91"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl bg-[#06C755] hover:opacity-95 text-white font-bold text-sm sm:text-base text-center shadow-lg transition flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 5.918 2 10.751c0 3.332 2.131 6.223 5.309 7.643-.233.784-.848 2.855-.972 3.29-.153.535.195.526.411.383.17-.113 2.709-1.841 3.806-2.587.47.07 1.05.108 1.646.108 5.523 0 10-3.918 10-8.751C22 5.918 17.523 2 12 2z"/>
            </svg>
            <span>LINEで相談する</span>
          </a>

          <a
            href="/diagnosis"
            class="px-8 py-4 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm sm:text-base text-center shadow-lg transition flex items-center justify-center gap-2"
          >
            <span>無料診断を受ける（3分）</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <div class="pt-8 grid grid-cols-2 sm:grid-cols-3 gap-6 border-t border-brand-800/80 text-slate-300">
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-serif text-brand-300">平成17年</div>
            <div class="text-xs text-slate-400 mt-0.5">創業・設立（20年の実績）</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold font-serif text-brand-300">実業×内製</div>
            <div class="text-xs text-slate-400 mt-0.5">福祉・サロン・開発の自社実践</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-2xl sm:text-3xl font-bold font-serif text-brand-300">戦略＋実装</div>
            <div class="text-xs text-slate-400 mt-0.5">助言で終わらない完全ワンストップ</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ② 経営者が抱える課題 -->
  <section class="py-20 sm:py-28 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          CHALLENGES
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          こんな経営課題を抱えていませんか？
        </h2>
        <p class="text-sm sm:text-base text-gray-600">
          現場の頑張りだけでは解決できない「構造的なボトルネック」が会社の成長と利益を阻んでいます。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">01</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">売上はあるが利益が残らない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            忙しく働いているのに月末や決算期に手元キャッシュが薄い。案件ごとの正確な採算が把握できておらず、不採算業務が利益を圧迫しています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">02</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">業務が属人化している</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            「あの人しか分からない」業務ばかりで、担当者が休むと業務がストップ。マニュアルが形骸化し、新人育成にも多大なコストがかかっています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">03</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">集客が安定しない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            来月や3ヶ月後の見込み客獲得が紹介や人脈頼み。HPやSNSはあるものの、実際の問い合わせや商談に繋がる導線が機能していません。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">04</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">日々の業務に追われ改善が進まない</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            社長自身が現場実務やトラブル対応に忙殺され、中長期の経営戦略や新規事業、仕組みづくりに向き合う時間が取れていません。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">05</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">IT・AIを活用したいが何から始めればよいか不明</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            世の中のDXツールやAIは難解で、自社にどう当てはまるか分からない。高いシステムを入れても使いこなせず放置される懸念を抱えています。
          </p>
        </div>

        <div class="bg-sand-50 p-8 rounded-2xl border border-sand-200 hover:border-brand-500 hover:shadow-lg transition">
          <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center font-bold text-sm mb-4">06</div>
          <h3 class="text-lg font-bold font-serif text-slate-900 mb-2">新しい事業を始めたいが仕組みづくりに不安</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            新たな収益の柱を作りたいが、企画、集客、業務フロー、現場オペレーションを一から構築するリソースや知見が社内に不足しています。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ MSTの支援方針 -->
  <section class="py-20 sm:py-28 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          OUR POLICY
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          MSTの支援方針
        </h2>
        <p class="text-sm sm:text-base text-gray-600">
          改善を一度きりで終わらせず、継続的な成長につなげる4段階のアプローチ。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-3">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2.5 py-1 rounded inline-block">STEP 1</div>
          <h3 class="text-lg font-bold font-serif text-slate-900">課題の整理</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            経営の数字と現場実務を棚卸しし、最優先で手をつけるべき真のボトルネックを特定。
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-3">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2.5 py-1 rounded inline-block">STEP 2</div>
          <h3 class="text-lg font-bold font-serif text-slate-900">改善戦略の設計</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            利益改善、業務標準化、集客導線、IT活用の方針など、無理のない具体策を設計。
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-3">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2.5 py-1 rounded inline-block">STEP 3</div>
          <h3 class="text-lg font-bold font-serif text-slate-900">仕組みの構築・実装</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            助言だけで終わらせず、GAS・ツール・LP・マニュアルなど動く仕組みを自社で実装。
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-3">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2.5 py-1 rounded inline-block">STEP 4</div>
          <h3 class="text-lg font-bold font-serif text-slate-900">運用・継続改善</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            現場での運用定着を確認し、数字の変化に合わせて継続的に改善を伴走します。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ④ サービス紹介 -->
  <section class="py-20 sm:py-28 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          SERVICES
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          MSTが提供するサービス
        </h2>
        <p class="text-sm text-gray-600">
          各サービスごとに専用ページをご用意しています。詳細は各カードよりご覧いただけます。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((s) => (
          <div class="bg-sand-50 rounded-2xl border border-sand-300 p-8 flex flex-col justify-between hover:border-brand-500 hover:shadow-xl transition-all group">
            <div class="space-y-3">
              <span class="text-2xl font-bold font-serif text-gray-300 group-hover:text-brand-500 transition-colors">
                {s.num}
              </span>
              <h3 class="text-lg font-bold font-serif text-slate-900 group-hover:text-brand-600 transition-colors">
                {s.title}
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                {s.desc}
              </p>
            </div>
            <div class="pt-6 border-t border-sand-200 mt-6">
              <a
                href={s.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900 group-hover:translate-x-1 transition-all"
              >
                <span>サービス詳細を見る</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ 支援の進め方 -->
  <section class="py-20 sm:py-28 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          FLOW
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          支援の進め方
        </h2>
        <p class="text-sm text-gray-600">
          初回相談から改善の実行・定着まで、透明性の高いステップで進めます。
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-4">
        {steps.map((st) => (
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <div class="w-12 h-12 rounded-xl bg-brand-900 text-white font-serif font-bold text-lg flex items-center justify-center shrink-0">
              {st.num}
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold font-serif text-slate-900">{st.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{st.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ お役立ち情報・自社メディア最新記事 -->
  <section class="py-20 sm:py-28 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
        <div class="space-y-2">
          <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
            OWN MEDIA
          </span>
          <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
            お役立ち情報・最新記事
          </h2>
          <p class="text-sm text-gray-600">現場の実践から得られた経営・業務改善ノウハウを配信中。</p>
        </div>
        <a
          href="/media"
          class="shrink-0 text-xs font-bold text-brand-700 hover:text-brand-900 underline"
        >
          記事一覧をすべて見る →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {ARTICLES.slice(0, 3).map((a) => (
          <article class="bg-sand-50 rounded-2xl border border-sand-300 p-6 flex flex-col justify-between hover:shadow-md transition group">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs text-gray-500">
                <span class="font-bold text-brand-700 bg-white px-2.5 py-0.5 rounded border border-sand-200">
                  {a.category}
                </span>
                <time>{a.publishedAt}</time>
              </div>
              <h3 class="text-base font-bold font-serif text-slate-900 group-hover:text-brand-600 transition leading-snug">
                <a href={`/media/${a.slug}`}>{a.title}</a>
              </h3>
              <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed">{a.summary}</p>
            </div>
            <div class="pt-4 border-t border-sand-200 mt-4 text-right">
              <a href={`/media/${a.slug}`} class="text-xs font-bold text-brand-700 hover:text-brand-900">
                記事を読む →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ 無料診断・資料請求への導線 -->
  <section class="py-20 sm:py-28 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          FREE RESOURCES
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold font-serif text-slate-900">
          まずは無料の2大アクションから
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white p-8 rounded-2xl border border-sand-300 shadow-sm flex flex-col justify-between">
          <div class="space-y-3">
