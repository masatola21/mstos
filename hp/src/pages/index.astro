---
import Layout from '../layouts/Layout.astro';
import { getLiveArticles } from '../data/articles';

const liveArticles = await getLiveArticles();

// ファーストビュー背景用スライドショー（OWNERSONE-WITH風のズーム＆クロスフェード）
const heroSlides = [
  {
