---
import Layout from '../../layouts/Layout.astro';

// A. 主軸サービス（MSTの中心商品）
const coreServices = [
  {
    id: 'strategy',
    num: '01',
    title: '経営戦略・利益改善顧問',
    badge: '主軸サービス',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    desc: '経営者の右腕として、経営課題の整理から現場の業務改善まで、会社全体を見渡して伴走します。利益構造の改善・戦略立案はもちろん、業務フローの属人化解消や効率化も含めて一緒に取り組みます。',
    target: '売上はあるが利益が残らない企業、業務の非効率や属人化に悩みながら経営全体の相談相手が欲しい経営者',
    href: '/services/strategy',
  },
  {
    id: 'it-dx',
    num: '02',
    title: '業務改善・IT・DX・AI顧問',
    badge: '主軸サービス',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    desc: '業務プロセスの分析、改善計画の策定、業務効率化、身の丈に合ったIT・DX・生成AI活用の設計と継続支援を行います。IT・DX・AIの活用に特化した専門顧問として、ツール選定・要件整理・定着支援を中心に扱います。',
    target: 'ITツールやAIを具体的に業務へ組み込みたい企業、DX推進の専門的な伴走が欲しい企業',
    href: '/services/it-dx',
  },
];

// B. 主要サービス（顧問で整理・設計した改善策を具体的に実装）
const implementationServices = [
  {
    id: 'system',
    num: '03',
    title: 'システム構築・業務自動化',
    badge: '主要サービス（実装）',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
    desc: '社内の手作業をなくす業務自動化（GAS/API）はもちろん、ITが苦手な現場スタッフでもスマホで迷わず操作できる「現場直結の専用アプリ」をスピード構築。現場のデータが本社管理へリアルタイムに連動する仕組みを整えます。',
    href: '/services/system',
  },
  {
    id: 'marketing',
    num: '04',
    title: 'マーケティング戦略・集客導線構築',
    badge: '主要サービス（実装）',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>`,
    desc: 'ターゲット、商品、販売戦略に合わせて、認知から問い合わせ・商談・成約までの導線を設計・構築。紹介頼みを脱却し、見込み客が継続して集まる基盤を整えます。',
    href: '/services/marketing',
  },
];
---

<Layout
  title="サービス一覧 | 有限会社MST - 経営の仕組み化 × 利益改善"
  description="MSTの支援サービス一覧。経営課題の整理・戦略設計から、現場業務の自動化・システム実装まで。主軸サービス、主要サービス、関連サービス、専門商品の4区分でご案内。"
>
  <!-- ページヘッダー -->
  <section class="bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white py-16 sm:py-24 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-300 tracking-widest uppercase bg-brand-800 px-3.5 py-1.5 rounded-full border border-brand-700">
        SERVICES & SOLUTIONS
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold font-serif text-white">
        支援サービス一覧
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        経営課題の整理・戦略設計から、現場業務の自動化・仕組み実装まで。<br class="hidden sm:inline" />
        貴社のステージと課題の優先度に合わせた最適な支援体系をご提供します。
      </p>
    </div>
  </section>

  <!-- MSTの支援方針（4段階のアプローチ） -->
  <section class="py-16 bg-sand-100 border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          OUR APPROACH
        </span>
        <h2 class="text-2xl font-bold font-serif text-slate-900 mt-2">
          MSTの支援方針
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-1">
          経営課題の整理から始まり、必要に応じた構築・実装、契約範囲に応じた運用・保守まで一貫して支援します。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-sand-300 shadow-sm space-y-2">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2 py-0.5 rounded inline-block">STEP 1</div>
          <h3 class="text-base font-bold font-serif text-slate-900">課題の整理</h3>
          <p class="text-xs text-gray-600 leading-relaxed">経営数字と現場実務を棚卸しし、真のボトルネックを特定。</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-sand-300 shadow-sm space-y-2">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2 py-0.5 rounded inline-block">STEP 2</div>
          <h3 class="text-base font-bold font-serif text-slate-900">改善戦略の設計</h3>
          <p class="text-xs text-gray-600 leading-relaxed">利益改善、業務標準化、集客導線、IT活用の方針を無理なく設計。</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-sand-300 shadow-sm space-y-2">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2 py-0.5 rounded inline-block">STEP 3</div>
          <h3 class="text-base font-bold font-serif text-slate-900">仕組みの構築・実装</h3>
          <p class="text-xs text-gray-600 leading-relaxed">必要に応じて、GAS・ツール・LP・マニュアルなど動く仕組みを具体的に実装。</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-sand-300 shadow-sm space-y-2">
          <div class="text-xs font-bold text-brand-700 bg-brand-50 px-2 py-0.5 rounded inline-block">STEP 4</div>
          <h3 class="text-base font-bold font-serif text-slate-900">運用・継続改善</h3>
          <p class="text-xs text-gray-600 leading-relaxed">契約範囲に応じて運用定着を検証し、数字の変化に合わせて継続伴走。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- A. 主軸サービス（MSTの中心商品） -->
  <section class="py-16 sm:py-24 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-900 text-white text-xs font-bold mb-3">
          区分 A
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900">
          主軸サービス（経営・業務改善顧問）
        </h2>
        <p class="text-sm text-gray-600 mt-2">
          MSTの中心商品です。経営者の右腕として、会社全体の経営課題の整理、戦略立案、利益改善、業務の属人化解消に継続して伴走します。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {coreServices.map((s) => (
          <div class="bg-sand-50 rounded-2xl border-2 border-brand-400/80 p-8 flex flex-col justify-between hover:border-brand-600 hover:shadow-xl transition-all group">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-white bg-brand-900 px-3 py-1 rounded-full">
                  {s.badge}
                </span>
                <span class="text-3xl font-bold font-serif text-brand-300 group-hover:text-brand-600 transition-colors">
                  {s.num}
                </span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-900 text-brand-300 flex items-center justify-center shrink-0" set:html={s.icon} />
                <h3 class="text-xl sm:text-2xl font-bold font-serif text-slate-900 group-hover:text-brand-600 transition-colors leading-snug">
                  {s.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                {s.desc}
              </p>
              <div class="p-3 bg-white rounded-xl border border-sand-200 text-xs text-gray-600">
                <strong class="text-slate-900 block mb-0.5">主な対象：</strong>
                {s.target}
              </div>
            </div>

            <div class="pt-6 border-t border-sand-200 mt-6 flex items-center justify-between">
              <a
                href={s.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900 group-hover:translate-x-1 transition-all"
              >
                <span>サービス詳細を見る</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a
                href={`/contact?service=${s.id}`}
                class="text-xs font-bold text-brand-900 bg-white px-3.5 py-1.5 rounded-lg border border-sand-300 hover:bg-brand-50 transition"
              >
                相談する
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- B. 主要サービス（実装・仕組み構築） -->
  <section class="py-16 sm:py-24 bg-sand-100 border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-700 text-white text-xs font-bold mb-3">
          区分 B
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900">
          主要サービス（仕組み構築・実装）
        </h2>
        <p class="text-sm text-gray-600 mt-2">
          顧問で整理・設計した改善方針や導線を、実際の現場で機能する形に具体化・実装する主要サービスです。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {implementationServices.map((s) => (
          <div class="bg-white rounded-2xl border border-sand-300 p-8 flex flex-col justify-between hover:border-brand-500 hover:shadow-lg transition-all group">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
                  {s.badge}
                </span>
                <span class="text-2xl font-bold font-serif text-gray-300 group-hover:text-brand-500 transition-colors">
                  {s.num}
                </span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center shrink-0" set:html={s.icon} />
                <h3 class="text-xl font-bold font-serif text-slate-900 group-hover:text-brand-600 transition-colors">
                  {s.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                {s.desc}
              </p>
            </div>

            <div class="pt-6 border-t border-sand-200 mt-6 flex items-center justify-between">
              <a
                href={s.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900 group-hover:translate-x-1 transition-all"
              >
                <span>サービス詳細を見る</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a
                href={`/contact?service=${s.id}`}
                class="text-xs font-bold text-slate-700 hover:text-brand-900 underline"
              >
                構築を相談する →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- C. 関連サービス ＆ D. 専門商品 -->
  <section class="py-16 sm:py-24 bg-white border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- C. 関連サービス：新規事業支援 -->
        <div class="bg-sand-50 rounded-2xl border border-sand-300 p-8 flex flex-col justify-between hover:border-brand-500 hover:shadow-lg transition">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-600 bg-white px-3 py-1 rounded-full border border-sand-300">
                区分 C 関連サービス
              </span>
              <span class="text-xl font-bold font-serif text-gray-400">05</span>
            </div>
            <h3 class="text-xl font-bold font-serif text-slate-900">
              新規事業の企画・立ち上げ・仕組み化支援
            </h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              既存事業に次ぐ第2の収益の柱を構築。経営支援、業務改善、マーケティング、システム構築の総合力を組み合わせ、事業構想から初期負担・事業リスクを考慮した立ち上げまで伴走します。個別ニーズに合わせてご相談を受け付けます。
            </p>
          </div>
          <div class="pt-6 border-t border-sand-200 mt-6 flex items-center justify-between">
            <a
              href="/services/new-business"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900"
            >
              <span>サービス詳細を見る</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a
              href="/contact?service=new-business"
              class="text-xs font-bold text-slate-700 hover:text-brand-900 underline"
            >
              相談する →
            </a>
          </div>
        </div>

        <!-- D. 専門商品：介護保険外サービス開業パッケージ -->
        <div class="bg-gradient-to-br from-brand-900 to-slate-900 text-white rounded-2xl p-8 flex flex-col justify-between shadow-lg">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-brand-300 bg-brand-800 px-3 py-1 rounded-full border border-brand-700">
                区分 D 専門商品
              </span>
              <span class="text-xl font-bold font-serif text-brand-400">06</span>
            </div>
            <div>
              <span class="text-xs text-brand-300 font-bold block mb-1">新しい事業を、ゼロから作らない。</span>
              <h3 class="text-xl font-bold font-serif text-white">
                介護保険外サービス開業パッケージ
              </h3>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              介護保険外生活支援サービスの開業を目指す方向けの専門商品です。自社直営事業「アシスタ大垣」の実践基盤をもとに、事業設計、集客・営業基盤、業務システム、全10回の開業・運営サポートを提供します。詳細説明と成約導線は専用LPに集約しています。
            </p>
          </div>
          <div class="pt-6 border-t border-brand-800/80 mt-6 flex flex-col sm:flex-row gap-3">
            <a
              href="https://business.mstcorp.info/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 py-3 px-4 bg-brand-500 hover:bg-brand-400 text-white font-bold text-xs rounded-xl text-center transition flex items-center justify-center gap-1.5 shadow"
            >
              <span>専用LPを見る（料金・詳細）</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <a
              href="/services/care-package"
              class="py-3 px-4 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-xl text-center transition border border-white/20"
            >
              サイト内概要
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ③ OWNERSONE風：支援形態・料金体系の透明な比較テーブル（プラン比較） -->
  <section class="py-16 sm:py-24 bg-sand-100 border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-brand-700 uppercase tracking-widest bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          PLAN & SCOPE COMPARISON
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900 mt-2">
          支援形態・役割範囲の透明な比較表
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-2">
          MSTでは、助言と実装の責任範囲を曖昧にせず、安心してご依頼いただけるよう3つの提供形態を明確に区分してご提示しています。
        </p>
      </div>

      <!-- 比較テーブル（PC/スマホ対応） -->
      <div class="bg-white rounded-2xl border border-sand-300 shadow-sm overflow-hidden max-w-5xl mx-auto">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-brand-950 text-white border-b border-brand-800">
                <th class="py-4 px-5 text-xs font-bold w-1/4">支援項目・提供内容</th>
                <th class="py-4 px-5 text-xs font-bold w-1/4 text-center bg-brand-900/90 border-x border-brand-800">
                  <span class="block text-brand-300 text-[10px]">主軸</span>
                  ① 顧問支援（戦略・業務効率化設計・伴走）
                </th>
                <th class="py-4 px-5 text-xs font-bold w-1/4 text-center border-r border-brand-800">
                  <span class="block text-amber-300 text-[10px]">必要に応じて</span>
                  ② 構築支援（システム・ツール・導線実装）
                </th>
                <th class="py-4 px-5 text-xs font-bold w-1/4 text-center">
                  <span class="block text-slate-400 text-[10px]">稼働後</span>
                  ③ 保守支援（運用維持）
                </th>
              </tr>
            </thead>
