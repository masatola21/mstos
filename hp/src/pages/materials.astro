---
import Layout from '../layouts/Layout.astro';
import MaterialForm from '../components/MaterialForm';
---

<Layout
  title="経営改善実務ガイド・介護保険外開業資料請求 | 有限会社MST"
  description="中小企業が利益を残すための「経営の仕組み化」実務ガイドブック、および介護保険外サービス開業パッケージ資料を無料ダウンロード。現場実践に基づく具体策と実務手順を網羅。"
>
  <!-- ページヘッダー -->
  <section class="bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white py-14 sm:py-20 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold text-brand-300 tracking-widest uppercase bg-brand-800 px-3.5 py-1.5 rounded-full border border-brand-700">
        DOWNLOAD GUIDE & MATERIALS
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold font-serif text-white">
        実務ガイド・サービス資料請求
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-light">
        中小企業の「経営の仕組み化・利益改善」と「介護保険外サービス開業」の実践論を凝縮した特別資料。<br class="hidden sm:inline" />
        フォーム送信後、すぐにPDFをダウンロードしてご確認いただけます。
      </p>
    </div>
  </section>

  <!-- 資料のポイント ＆ 請求フォーム -->
  <section class="py-12 sm:py-20 bg-sand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- 資料の紹介・見どころ -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-sand-300 shadow-sm space-y-6">
            <span class="text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
              無料ダウンロード配布中
            </span>
            <h2 class="text-xl font-bold font-serif text-slate-900">
              ご提供している2つの実務資料
            </h2>

            <!-- 資料1: 経営改善実務ガイド -->
            <div class="p-4 bg-sand-50/70 rounded-xl border border-sand-200 space-y-2">
              <span class="text-[11px] font-bold text-brand-800 bg-brand-100/80 px-2.5 py-0.5 rounded">資料 ①</span>
              <h3 class="text-sm font-bold text-slate-900">経営改善実務ガイドブック（要点解説スライド）</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-light">
                なぜ売上が伸びても利益が残らないのか、その構造的ボトルネックを解説。業務自動化・伴走顧問・専用ツールの導入による自社実践データを公開しています。
              </p>
            </div>

            <!-- 資料2: 介護保険外開業パッケージ -->
            <div class="p-4 bg-emerald-50/70 rounded-xl border border-emerald-200 space-y-2">
              <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded">資料 ②</span>
              <h3 class="text-sm font-bold text-slate-900">介護保険外サービス開業パッケージ資料</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-light">
                直営店舗の実践データに基づく提供メニュー設計・集客導線（Web/LINE/カルテ管理）の完全マニュアル。既存介護事業者の新規事業立ち上げにも最適です。
              </p>
            </div>

            <!-- 安心の注記 -->
            <div class="border-t border-sand-200 pt-4 text-[11px] text-gray-500 space-y-1">
              <div>✓ 送信直後に画面上でPDFを直接閲覧いただけます。</div>
              <div>✓ 送信後のしつこい営業電話等は一切ございません。</div>
              <div>✓ ご希望に応じて、自社に合わせた30分オンライン無料面談も承ります。</div>
            </div>
          </div>
        </div>

        <!-- ダウンロードフォーム -->
        <div class="lg:col-span-7">
          <MaterialForm client:load />
        </div>

      </div>
    </div>
  </section>
</Layout>
